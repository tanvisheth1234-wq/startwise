# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=            # your own dev project while building
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only: delete-my-data, admin
DATABASE_URL=                        # Postgres connection string (pooler)
AI_PROVIDER=gemini                   # gemini | openai
AI_API_KEY=
AI_API_KEY_2=                        # optional backup key (another free-tier project)
AI_MODEL=                            # chat model chosen on Day 1
AI_EMBED_MODEL=                      # must support 768-dim output
ADMIN_EMAILS=t1@example.com,t2@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
